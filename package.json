{
  "name": "mouse-on-rails",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "tauri": "tauri",
    "tauri:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle",
    "voices": "node scripts/generate-voices.mjs",
    "voices:force": "node scripts/generate-voices.mjs --force"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
